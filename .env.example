# ==============================================================================
# TRUTHLENS ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and configure your environment credentials.
# NEVER commit .env.local with real secrets into source control.

# ------------------------------------------------------------------------------
# 1. AI PROVIDER (Google Gemini API)
# ------------------------------------------------------------------------------
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=""
AI_MODEL="gemini-3.6-flash"

# ------------------------------------------------------------------------------
# 2. FIREBASE CONFIGURATION (Client SDK)
# ------------------------------------------------------------------------------
# Firebase Project Settings -> General -> Web App configuration
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK (Server-Side Service Account)
# ------------------------------------------------------------------------------
# Firebase Project Settings -> Service Accounts -> Generate new private key
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 4. GITHUB OAUTH APPLICATION (Repository Authorization)
# ------------------------------------------------------------------------------
# GitHub -> Settings -> Developer Settings -> OAuth Apps -> New OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 5. BLOCKCHAIN CONFIGURATION (Polygon Amoy Testnet & ERC-5192)
# ------------------------------------------------------------------------------
# Polygon Amoy RPC URL & Soulbound contract deployment
POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology/"
NEXT_PUBLIC_SOULBOUND_CONTRACT_ADDRESS="0x959922bE3CAee4b8Cd9a407cc3ac1C251C2007B1"
ISSUER_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 6. IPFS CONFIGURATION (Pinata Decentralized Metadata Storage)
# ------------------------------------------------------------------------------
# Pinata API Keys -> JWT with pinJSONToIPFS & pinFileToIPFS permissions
PINATA_JWT=""
PINATA_GATEWAY_URL="https://gateway.pinata.cloud/ipfs/"

# ------------------------------------------------------------------------------
# 7. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
